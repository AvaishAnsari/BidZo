DEBUG=True
# Required when DEBUG=False. Generate a unique random value and keep it private.
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
# Set these to your deployed frontend and backend origins for production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=
# Use DATABASE_URL or the DB_* values below (never commit real credentials).
# DATABASE_URL=postgresql://user:password@host:5432/bidzo_db
DB_NAME=bidzo_db
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
# Local OTP development uses the console backend; codes appear in the Django terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=BidZo <no-reply@bidzo.local>
# Optional Razorpay test/live credentials. Payments remain disabled without both values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional Google reCAPTCHA secret for server-side verification.
RECAPTCHA_SECRET_KEY=
# Add a real SMS provider before enabling SMS OTP in production.
# Add Razorpay credentials only after configuring and testing your merchant account.
