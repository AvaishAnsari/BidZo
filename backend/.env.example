DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production
DB_NAME=bidzo_db
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
# Local OTP development uses the console backend; codes appear in the Django terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=BidZo <no-reply@bidzo.local>
# Optional Razorpay test/live credentials. Payments remain disabled without both values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional Google reCAPTCHA secret for server-side verification.
RECAPTCHA_SECRET_KEY=
